# 1. Берем официальный базовый образ Python (легковесную версию slim)
FROM python:3.10-slim

# 2. Указываем рабочую директорию внутри контейнера
WORKDIR /app

# 3. Сначала копируем только файл с зависимостями (чтобы Docker использовал кэш слоев)
COPY requirements.txt .

# 4. Устанавливаем зависимости
RUN pip install --no-cache-dir -r requirements.txt

# 5. Копируем весь остальной код проекта в контейнер
COPY . .

# 6. Открываем порт 8000, на котором работает FastAPI
EXPOSE 8000

# 7. Команда по умолчанию при запуске контейнера
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
